# =============================================================
# SERVIÇO: api  (FastAPI — raiz do repositório)
# =============================================================

# Azure OpenAI
AZURE_KEY=sua_chave_azure_openai
AZURE_URL=https://seu-recurso.openai.azure.com/
DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-06-01

# OpenAI direto (opcional, usado como fallback pelo LangChain)
OPENAI_API_KEY=

# Diretório temporário de uploads (ephemeral no Railway — OK para análises curtas)
UPLOAD_DIR=/tmp/lean-six-sigma-uploads

# CORS: domínio do frontend Railway (ex: https://chatsmart-frontend.up.railway.app)
# Use * para liberar tudo (apenas em dev/testes)
CORS_ORIGINS=*


# =============================================================
# SERVIÇO: frontend  (Django — rootDirectory: frontend/)
# =============================================================

# Chave secreta Django — gere uma em: https://djecrety.ir
DJANGO_SECRET_KEY=troque-por-uma-chave-segura-gerada

# False em produção
DEBUG=False

# Domínio Railway do serviço frontend (sem https://, sem barra final)
# Ex: chatsmart-frontend.up.railway.app
ALLOWED_HOSTS=chatsmart-frontend.up.railway.app

# URL pública do serviço da API no Railway
API_URL=https://chatsmart-api.up.railway.app

# Diretório de mídia (datasets enviados pelos usuários)
# Monte um volume Railway neste caminho para persistência entre deploys
MEDIA_ROOT=/data/media


# =============================================================
# BANCO DE DADOS — PostgreSQL via Supabase (usado pelo Django)
# =============================================================

# Defina como True apenas para desenvolvimento local com SQLite
USE_SQLITE_DB=False

SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=sua_senha_supabase
SUPABASE_DB_HOST=db.xxxxxxxxxx.supabase.co
SUPABASE_DB_PORT=5432
